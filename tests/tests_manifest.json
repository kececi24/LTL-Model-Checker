{
  "test_suite": "BLG345E Phase 1 Kripke Structure Model Checker Test Suite",
  "version": "1.0",
  "tests": [
    {
      "id": "valid_01",
      "file": "valid/01_light_switch.json",
      "category": "valid",
      "description": "Standard two-state light switch model from PDF Example 0",
      "expected_exit_code": 0,
      "expected_output_prefixes": ["[PARSER]", "[METRICS]", "[REACHABILITY]", "[DIAGNOSTICS]"],
      "expected_metrics": {
        "total_states": 2,
        "total_transitions": 4,
        "reachable_states": 2,
        "unreachable_states": 0
      },
      "pdf_reference": "Section 2: Example 0 (p. 3)"
    },
    {
      "id": "valid_02",
      "file": "valid/02_unreachable_states.json",
      "category": "valid",
      "description": "Model with unreachable states; must be accepted as valid and report unreachable count > 0",
      "expected_exit_code": 0,
      "expected_output_prefixes": ["[PARSER]", "[METRICS]", "[REACHABILITY]", "[DIAGNOSTICS]"],
      "expected_metrics": {
        "total_states": 4,
        "total_transitions": 4,
        "reachable_states": 2,
        "unreachable_states": 2
      },
      "pdf_reference": "Additional Parser Test Cases #5 (p. 4), Phase 3 (p. 11)"
    },
    {
      "id": "valid_03",
      "file": "valid/03_multiple_initial_states.json",
      "category": "valid",
      "description": "Model containing multiple initial states branching to a common target",
      "expected_exit_code": 0,
      "expected_output_prefixes": ["[PARSER]", "[METRICS]", "[REACHABILITY]", "[DIAGNOSTICS]"],
      "expected_metrics": {
        "total_states": 3,
        "total_transitions": 4,
        "reachable_states": 3,
        "unreachable_states": 0
      },
      "pdf_reference": "Section 1.3 (p. 2), Phase 3 (p. 11)"
    },
    {
      "id": "valid_04",
      "file": "valid/04_single_state_self_loop.json",
      "category": "valid",
      "description": "Minimal valid single-state Kripke structure with a self-loop",
      "expected_exit_code": 0,
      "expected_output_prefixes": ["[PARSER]", "[METRICS]", "[REACHABILITY]", "[DIAGNOSTICS]"],
      "expected_metrics": {
        "total_states": 1,
        "total_transitions": 1,
        "reachable_states": 1,
        "unreachable_states": 0
      },
      "pdf_reference": "Phase 2.3 Transition Totality (p. 11)"
    },
    {
      "id": "valid_05",
      "file": "valid/05_dining_philosophers_sample.json",
      "category": "valid",
      "description": "Dining philosophers sub-model showing deadlock state modeled via self-loop",
      "expected_exit_code": 0,
      "expected_output_prefixes": ["[PARSER]", "[METRICS]", "[REACHABILITY]", "[DIAGNOSTICS]"],
      "expected_metrics": {
        "total_states": 4,
        "total_transitions": 6,
        "reachable_states": 4,
        "unreachable_states": 0
      },
      "pdf_reference": "Problem 1 (p. 5), Phase 2.3 (p. 11)"
    },
    {
      "id": "valid_06",
      "file": "valid/06_complex_branching_and_cycles.json",
      "category": "valid",
      "description": "Complex graph with multiple branches, cycles, and an unreachable subcomponent",
      "expected_exit_code": 0,
      "expected_output_prefixes": ["[PARSER]", "[METRICS]", "[REACHABILITY]", "[DIAGNOSTICS]"],
      "expected_metrics": {
        "total_states": 7,
        "total_transitions": 8,
        "reachable_states": 5,
        "unreachable_states": 2
      },
      "pdf_reference": "Phase 3 (p. 11)"
    },
    {
      "id": "syntax_01",
      "file": "syntax_error/syntax_unclosed_brace.json",
      "category": "syntax_error",
      "description": "JSON document missing closing brace",
      "expected_exit_code": 1,
      "expected_error_prefix": "[SYNTAX ERROR]",
      "pdf_reference": "Phase 1.1 (p. 10), Error Handling (p. 13)"
    },
    {
      "id": "syntax_02",
      "file": "syntax_error/syntax_trailing_comma.json",
      "category": "syntax_error",
      "description": "JSON array contains an illegal trailing comma",
      "expected_exit_code": 1,
      "expected_error_prefix": "[SYNTAX ERROR]",
      "pdf_reference": "Phase 1.1 (p. 10), Error Handling (p. 13)"
    },
    {
      "id": "syntax_03",
      "file": "syntax_error/syntax_missing_colon.json",
      "category": "syntax_error",
      "description": "JSON object missing colon delimiter after key",
      "expected_exit_code": 1,
      "expected_error_prefix": "[SYNTAX ERROR]",
      "pdf_reference": "Phase 1.1 (p. 10), Error Handling (p. 13)"
    },
    {
      "id": "syntax_04",
      "file": "syntax_error/syntax_unquoted_key.json",
